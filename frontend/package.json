{
  "name": "kalshibot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web dashboard for the kalshibot Kalshi PAPER-trading bot.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.9.0",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "5.9.3",
    "vite": "7.3.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
