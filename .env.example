# Copy to .env to set these persistently (./deploy.sh and docker compose read ./.env; an explicit
# environment variable wins). deploy.sh reads only these two keys. .env is not committed.

# Host port of the dashboard/API (default 8765).
KALSHIBOT_PORT=8765

# Address the port is bound to (default 127.0.0.1: this machine only). 0.0.0.0 exposes it on the
# network; the dashboard has NO authentication, so only do that on a trusted network.
KALSHIBOT_BIND=127.0.0.1
